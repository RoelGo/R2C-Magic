# --- server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# The app's canonical PUBLIC origin (scheme + host), used to build absolute
# redirect URLs such as the Lightspeed OAuth callback -> settings redirect.
# Behind a reverse proxy the container binds to 0.0.0.0:3000, so set this to
# the externally reachable URL. Must NOT be localhost/0.0.0.0 in production.
# Leave blank in local dev to fall back to the request's own origin.
APP_BASE_URL=

# --- storage ---
# Path to SQLite database file. In Docker this lives on the mounted volume.
DATABASE_URL=./data/r2c.db
# Directory for uploaded source CSVs and exported C-series CSVs (per run).
DATA_DIR=./data

# --- enrichment ---
# How many books to enrich in parallel.
ENRICH_CONCURRENCY=5
# How long cached hits + cached misses are reused, in days.
ENRICH_CACHE_TTL_DAYS=30
# Shorter TTL for cached upstream *errors* so transient 5xx/429 retry sooner.
ENRICH_ERROR_CACHE_TTL_HOURS=6
# Per-source request timeout, in milliseconds.
ENRICH_TIMEOUT_MS=10000
# Master kill-switch for online sources. Set to false to disable every
# adapter (useful for mapping-only runs without burning API quota).
ENRICHMENT_ENABLED=true

# --- sources ---
# Optional: a Google Books API key raises the anonymous rate limit.
GOOGLE_BOOKS_API_KEY=
# Open Library asks API consumers to identify themselves. Format: app/version (contact)
OPEN_LIBRARY_USER_AGENT=r2c-magic/0.1 (mailto:tech@rokko.coop)

# --- output ---
# When true, append a column with per-row enrichment errors to the C-series CSV.
INCLUDE_ERROR_COLUMN=true
ERROR_COLUMN_NAME=_enrichment_errors

# --- cover OCR (spec v2 US-D3/D4) ---
# Server-side OCR of cover photos to pre-fill title/description. Off by
# default; the photo flow works without any OCR engine installed.
OCR_ENABLED=false
# Which engine to run: pp-ocrv6 | none
OCR_ENGINE=pp-ocrv6
# Per-image OCR subprocess timeout, in milliseconds.
OCR_TIMEOUT_MS=30000
# PP-OCRv6 via scripts/pp_ocr.py: pip install paddleocr paddlepaddle
PP_OCR_PYTHON=python3
PP_OCR_SCRIPT=scripts/pp_ocr.py
# PP-OCRv6 model variant: tiny (fastest) | small (default, balanced) | medium
# (most accurate, slowest). Smaller models have a much shorter cold start.
PP_OCR_MODEL_SIZE=small
# Optional local PP-OCRv6 model directory (else PaddleOCR downloads on first use).
PP_OCR_MODEL_DIR=
# Layout-aware description detection (US-D6, exploratory): scripts/pp_layout.py
PP_LAYOUT_SCRIPT=scripts/pp_layout.py
# PaddleOCR layout-detection model (PP-DocLayout family).
PP_LAYOUT_MODEL=PP-DocLayout_plus-L

# --- lightspeed retail (spec v2 Slice F) ---
# rokko is on an omnichannel plan, so products are pushed through the Retail
# (R-Series) API, not the eCom API. Register an API client at
# https://developers.lightspeedhq.com/retail/authentication/clients/ and set
# the redirect URI to this app's callback. The "Connect to Lightspeed" flow in
# Settings is only available when the client id + secret + redirect are all set.
LIGHTSPEED_CLIENT_ID=
LIGHTSPEED_CLIENT_SECRET=
# Must EXACTLY match the redirect URI registered on the OAuth client. In
# production this is `${APP_BASE_URL}/api/lightspeed/callback`.
LIGHTSPEED_REDIRECT_URI=https://localhost:3000/api/lightspeed/callback
# Space-separated OAuth scopes to request (see
# https://developers.lightspeedhq.com/retail/authentication/scopes/).
LIGHTSPEED_SCOPES=employee:all

