# --- server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- storage ---
# Path to SQLite database file. In Docker this lives on the mounted volume.
DATABASE_URL=./data/r2c.db
# Directory for uploaded source CSVs and exported C-series CSVs (per run).
DATA_DIR=./data

# --- enrichment ---
# How many books to enrich in parallel.
ENRICH_CONCURRENCY=5
# How long cached hits + cached misses are reused, in days.
ENRICH_CACHE_TTL_DAYS=30
# Shorter TTL for cached upstream *errors* so transient 5xx/429 retry sooner.
ENRICH_ERROR_CACHE_TTL_HOURS=6
# Per-source request timeout, in milliseconds.
ENRICH_TIMEOUT_MS=10000
# Master kill-switch for online sources. Set to false to disable every
# adapter (useful for mapping-only runs without burning API quota).
ENRICHMENT_ENABLED=true

# --- sources ---
# Optional: a Google Books API key raises the anonymous rate limit.
GOOGLE_BOOKS_API_KEY=
# Open Library asks API consumers to identify themselves. Format: app/version (contact)
OPEN_LIBRARY_USER_AGENT=r2c-magic/0.1 (mailto:tech@rokko.coop)

# --- output ---
# When true, append a column with per-row enrichment errors to the C-series CSV.
INCLUDE_ERROR_COLUMN=true
ERROR_COLUMN_NAME=_enrichment_errors

# --- cover OCR (spec v2 US-D3/D4) ---
# Server-side OCR of cover photos to pre-fill title/description. Off by
# default; the photo flow works without any OCR engine installed.
OCR_ENABLED=false
# Which engine to run: ocrs | pp-ocrv6 | none
OCR_ENGINE=pp-ocrv6
# Per-image OCR subprocess timeout, in milliseconds.
OCR_TIMEOUT_MS=30000
# ocrs CLI (https://github.com/robertknight/ocrs): cargo install ocrs-cli
OCRS_BIN=ocrs
# PP-OCRv6 via scripts/pp_ocr.py: pip install paddleocr paddlepaddle
PP_OCR_PYTHON=python3
PP_OCR_SCRIPT=scripts/pp_ocr.py
# PP-OCRv6 model variant: tiny (fast, default) | small | medium (most accurate,
# slowest). Smaller models have a much shorter cold start.
PP_OCR_MODEL_SIZE=tiny
# Optional local PP-OCRv6 model directory (else PaddleOCR downloads on first use).
PP_OCR_MODEL_DIR=
