{
  "$schema": "./mapping.schema.json",
  "outputDelimiter": ";",
  "outputLineEnding": "CRLF",
  "outputBom": false,
  "imageSeparator": "|",
  "includeErrorColumn": true,
  "errorColumnName": "_enrichment_errors",

  "sourcePriority": ["cb", "google-books", "open-library"],

  "fieldPriority": {
    "titleShort": ["r-series", "cb", "google-books", "open-library"],
    "titleLong": ["cb", "google-books", "open-library", "r-series"],
    "descriptionShort": ["cb", "google-books", "open-library"],
    "descriptionLong": ["cb", "google-books", "open-library"],
    "publisher": ["cb", "google-books", "open-library"],
    "authors": ["cb", "google-books", "open-library"],
    "categories": ["cb", "google-books", "open-library"],
    "weightGrams": ["cb", "google-books", "open-library"],
    "dimensionsMm": ["cb", "google-books"],
    "coverImageUrls": "merge"
  },

  "columns": [
    { "name": "Visible", "type": "constant", "value": "Y" },
    { "name": "Brand", "type": "field", "from": ["enriched.authors", "rseries.brand"] },
    { "name": "Supplier", "type": "ignore" },
    {
      "name": "NL_Title_Short",
      "type": "field",
      "from": ["rseries.item", "cb.description"],
      "transform": { "truncate": 80 }
    },
    {
      "name": "NL_Title_Long",
      "type": "field",
      "from": ["enriched.titleLong", "rseries.item", "cb.description"]
    },
    {
      "name": "NL_Description_Short",
      "type": "field",
      "from": "enriched.descriptionShort",
      "transform": { "stripHtml": true, "truncate": 200 }
    },
    { "name": "NL_Description_Long", "type": "field", "from": "enriched.descriptionLong" },
    { "name": "NL_Variant", "type": "ignore" },
    { "name": "Price", "type": "ignore" },
    { "name": "Price_Old", "type": "ignore" },
    { "name": "Price_Cost", "type": "ignore" },
    { "name": "Price_Unit", "type": "ignore" },
    { "name": "Unit", "type": "ignore" },
    { "name": "Tax", "type": "ignore" },
    { "name": "Stock_Track", "type": "constant", "value": "Y" },
    { "name": "Stock_Disable_Sold_Out", "type": "constant", "value": "Y" },
    { "name": "Stock_Level", "type": "ignore" },
    { "name": "Stock_Min", "type": "ignore" },
    { "name": "Stock_Alert", "type": "ignore" },
    { "name": "Article_Code", "type": "ignore" },
    { "name": "EAN", "type": "field", "from": ["rseries.ean", "cb.ean"] },
    { "name": "SKU", "type": "ignore" },
    {
      "name": "Weight",
      "type": "field",
      "from": "enriched.weightGrams",
      "transform": { "divide": 1000 }
    },
    { "name": "Volume", "type": "ignore" },
    { "name": "Colli", "type": "ignore" },
    { "name": "Size_X", "type": "ignore" },
    { "name": "Size_Y", "type": "ignore" },
    { "name": "Size_Z", "type": "ignore" },
    { "name": "Matrix", "type": "ignore" },
    { "name": "Data_01", "type": "ignore" },
    { "name": "Data_02", "type": "ignore" },
    { "name": "Data_03", "type": "ignore" },
    { "name": "Buy_Min", "type": "ignore" },
    { "name": "Buy_Max", "type": "ignore" },
    { "name": "NL_Google_Category", "type": "constant", "value": "Media > Books" },
    { "name": "NL_Category_1", "type": "field", "from": "rseries.category" },
    { "name": "NL_Category_2", "type": "field", "from": "rseries.subcategory.0" },
    { "name": "NL_Category_3", "type": "field", "from": "rseries.subcategory.1" },
    { "name": "NL_Meta_Title", "type": "computed", "expression": "metaTitle" },
    {
      "name": "NL_Meta_Description",
      "type": "field",
      "from": "enriched.descriptionShort",
      "transform": { "stripHtml": true, "truncate": 160 }
    },
    { "name": "NL_Meta_Keywords", "type": "computed", "expression": "metaKeywords" },
    {
      "name": "Images",
      "type": "computed",
      "expression": "images",
      "default": "!ID:498887379"
    },
    { "name": "Tags", "type": "ignore" }
  ]
}
